{
  "name": "rune-fast",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun --preload ./scripts/test-preload.ts scripts/page-heads.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "bun test",
    "check:public": "bun --preload ./scripts/test-preload.ts scripts/check-public.ts",
    "check:masthead": "bun scripts/check-masthead.ts",
    "check:heads": "bun --preload ./scripts/test-preload.ts scripts/check-heads.ts",
    "check:load": "bun scripts/check-load.ts",
    "render:share": "bun --preload ./scripts/test-preload.ts scripts/render-share.ts",
    "check": "bun run typecheck && bun run test && bun run build && bun run check:public"
  },
  "dependencies": {
    "@rune/world": "workspace:*",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-time": "^3.1.0",
    "react": "18",
    "react-dom": "18",
    "react-router-dom": "7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-time": "^3.0.4",
    "@types/react": "18",
    "@types/react-dom": "18",
    "playwright-core": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
