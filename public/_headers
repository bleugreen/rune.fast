# Cross-origin isolation for the replay's worker pool (SharedArrayBuffer). Site-wide, because a
# client-side navigation to /replay/* never re-fetches the document that carries these headers.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Every file under /assets/ is named by its content (the build's hash), so a browser may keep it a
# year without asking again: a deploy that changes a file changes its name. Nothing unhashed here.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
